{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-attribution.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "timeout": 1.5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "timeout": 5.0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/givn-timeline.sh",
            "timeout": 5.0,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
