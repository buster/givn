{
  description = "givn — single-binary, Gherkin-first spec-driven workflow tool";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "aarch64-darwin"
        "x86_64-darwin"
        "aarch64-linux"
        "x86_64-linux"
      ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});
    in
    {
      packages = forAllSystems (pkgs: rec {
        givn = pkgs.rustPlatform.buildRustPackage {
          pname = "givn";
          version = "${(pkgs.lib.importTOML ./Cargo.toml).package.version}-${
            self.shortRev or self.dirtyShortRev or "dirty"
          }";
          src = self;
          cargoLock.lockFile = ./Cargo.lock;
          # Unit tests shell out to git.
          nativeCheckInputs = [ pkgs.git ];
          nativeBuildInputs = [ pkgs.installShellFiles ];
          # Completions are generated by the built binary, so only install
          # them when the build platform can execute the target binary.
          postInstall = pkgs.lib.optionalString (
            pkgs.stdenv.buildPlatform.canExecute pkgs.stdenv.hostPlatform
          ) ''
            installShellCompletion --cmd givn \
              --bash <($out/bin/givn completions bash) \
              --fish <($out/bin/givn completions fish) \
              --zsh <($out/bin/givn completions zsh)
          '';
          # Cucumber runners (features_runner, ready_fixture) need a full project checkout.
          cargoTestFlags = [
            "--lib"
            "--bins"
          ];
          meta = {
            description = "A single-binary, Gherkin-first spec-driven workflow tool";
            homepage = "https://github.com/buster/givn";
            license = with pkgs.lib.licenses; [
              gpl3Plus
            ];
            mainProgram = "givn";
          };
        };
        default = givn;
      });

      overlays.default = final: _prev: {
        givn = self.packages.${final.stdenv.hostPlatform.system}.default;
      };

      devShells = forAllSystems (pkgs: {
        default = pkgs.mkShell {
          packages = with pkgs; [
            cargo
            clippy
            rustc
            rustfmt
          ];
        };
      });
    };
}
