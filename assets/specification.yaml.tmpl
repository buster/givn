# The project's Specification Manifest: what a rebuild keeps, and which
# source entries may be replaced. Every entry is a project-relative path.
# Each category starts empty; declare the project's own entries before the
# first Ise Test, which refuses until they are declared.

# behavior — the executable behavior corpus.
# example: givn/specs/**
behavior: []

# structure — the structural and vocabulary documents.
# example: docs/glossary.md
structure: []

# contracts — the reference contracts consumers read.
# example: docs/reference.md
contracts: []

# limits — the recorded constraints and decisions.
# example: docs/arc42/02-architecture-constraints.md
limits: []

# e2e — the end-to-end test package the rebuild keeps.
# example: tests/e2e
e2e: []

# source — the replaceable source entries.
# example: src/**
source: []
