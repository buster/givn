#!/bin/sh
set -u

original="$0.givn-original"
if [ -x "$original" ] && ! grep -q 'givn commit-attribution launcher' "$original"; then
    "$original" "$@" || exit $?
fi

if [ -z "${GIVN_ATTRIBUTION_ACTIVE:-}" ]; then
    exit 0
fi

if ! command -v givn >/dev/null 2>&1; then
    exit 0
fi

givn attribution stamp --message-file "$1" >/dev/null 2>&1 || true
exit 0
